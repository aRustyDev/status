{
  "origin": "https://status.sow.foo",
  "backend": "cloudflare",
  "auth": "access",
  "selectorHeader": "X-Status-Preview",
  "selectorPattern": "^(?:[1-6]\\.[a-f0-9]{32}|branch-[a-f0-9]{24})$",
  "revisionHeader": "X-Status-Preview-Commit",
  "revisionPattern": "^[a-f0-9]{40}$",
  "identity": { "path": "/api/v1/auth/me", "equals": { "id": "preview-browser", "role": "viewer" } },
  "requiredPaths": ["/api/v1/bsp/public/locales"]
}
