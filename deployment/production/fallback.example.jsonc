{
  "account_id": "REPLACE_ACCOUNT_ID",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": false
    }
  },
  "name": "REPLACE_FALLBACK_WORKER_NAME",
  "main": "../../apps/fallback/index.ts",
  "assets": {
    "directory": "../../apps/status/dist-fallback",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_ACCESS_TEAM_DOMAIN",
    "ACCESS_AUD": "REPLACE_PRIVATE_ACCESS_AUDIENCE"
  },
  "services": [
    {
      "binding": "GATEWAY",
      "service": "REPLACE_GATEWAY_WORKER_NAME"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FALLBACK_BUCKET",
      "bucket_name": "REPLACE_PRIVATE_FALLBACK_BUCKET"
    }
  ],
  "routes": []
}
