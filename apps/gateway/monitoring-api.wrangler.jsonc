{
  "name": "status-monitoring-api",
  "main": "api.ts",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../board/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "staging": {
      "name": "status-monitoring-api-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ACCESS_TEAM_DOMAIN": "REPLACE_ACCESS_TEAM_DOMAIN",
        "ACCESS_AUD": "REPLACE_ACCESS_AUDIENCE",
        "DEPLOYMENT_ENVIRONMENT": "staging",
        "PREVIEW_BROWSER_ORIGIN": "",
        "PREVIEW_BROWSER_CLIENT_ID": "",
        "ENDPOINTS": "[]",
        "API_SCOPE": "monitoring"
      },
      "services": [
        { "binding": "PROBE", "service": "status-probe-staging" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "status-board-staging",
          "database_id": "REPLACE_STAGING_D1_ID",
          "migrations_dir": "../worker/migrations"
        }
      ]
    }
  }
}
