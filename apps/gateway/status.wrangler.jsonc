{
  "name": "status-ui",
  "main": "assets.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../status/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "staging": {
      "name": "status-ui-staging",
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
