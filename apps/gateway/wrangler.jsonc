{
  "name": "status-gateway",
  "main": "index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "staging": {
      "name": "status-gateway-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "UI_MODE": "legacy"
      },
      "services": [
        {
          "binding": "API",
          "service": "status-operations-staging"
        },
        {
          "binding": "STATUS_UI",
          "service": "status-ui-staging"
        },
        {
          "binding": "ADMIN_UI",
          "service": "status-admin-ui-staging"
        },
        {
          "binding": "STATUS_API",
          "service": "status-status-api-staging"
        },
        {
          "binding": "MONITORING_API",
          "service": "status-monitoring-api-staging"
        },
        {
          "binding": "PREVIEW_1_A",
          "service": "status-preview-1-a-gateway"
        },
        {
          "binding": "PREVIEW_1_B",
          "service": "status-preview-1-b-gateway"
        },
        {
          "binding": "PREVIEW_2_A",
          "service": "status-preview-2-a-gateway"
        },
        {
          "binding": "PREVIEW_2_B",
          "service": "status-preview-2-b-gateway"
        },
        {
          "binding": "PREVIEW_3_A",
          "service": "status-preview-3-a-gateway"
        },
        {
          "binding": "PREVIEW_3_B",
          "service": "status-preview-3-b-gateway"
        },
        {
          "binding": "PREVIEW_4_A",
          "service": "status-preview-4-a-gateway"
        },
        {
          "binding": "PREVIEW_4_B",
          "service": "status-preview-4-b-gateway"
        },
        {
          "binding": "PREVIEW_5_A",
          "service": "status-preview-5-a-gateway"
        },
        {
          "binding": "PREVIEW_5_B",
          "service": "status-preview-5-b-gateway"
        },
        {
          "binding": "PREVIEW_6_A",
          "service": "status-preview-6-a-gateway"
        },
        {
          "binding": "PREVIEW_6_B",
          "service": "status-preview-6-b-gateway"
        }
      ],
      "routes": [],
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "REPLACE_STAGING_FLAGSHIP_APP_ID"
        }
      ]
    }
  }
}
