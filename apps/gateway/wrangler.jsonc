{
  "name": "status-gateway",
  "main": "index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "staging": {
      "name": "status-gateway-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "UI_MODE": "legacy"
      },
      "services": [
        {
          "binding": "API",
          "service": "status-operations-staging"
        },
        {
          "binding": "STATUS_UI",
          "service": "status-ui-staging"
        },
        {
          "binding": "ADMIN_UI",
          "service": "status-admin-ui-staging"
        },
        {
          "binding": "STATUS_API",
          "service": "status-status-api-staging"
        },
        {
          "binding": "MONITORING_API",
          "service": "status-monitoring-api-staging"
        },
        {
          "binding": "PREVIEW_DISPATCHER",
          "service": "status-preview-dispatcher"
        }
      ],
      "routes": []
    }
  }
}
